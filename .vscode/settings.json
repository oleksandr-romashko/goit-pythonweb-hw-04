{
    // 🔤 Spell checker dictionary
    "cSpell.words": [
        "aiofiles",
        "aioshutil",
        "aiopath",
        "closefd",
        "colorama",
        "fspath",
        "levelname",
        "levelno",
        "myaiopath",
        "redef",
        "subfolders",
        "tomli"
    ],
    // 🧠 Python analysis & type checking
    // "python.analysis.typeCheckingMode": "strict", // full Pylance strict mode
    "python.analysis.diagnosticMode": "workspace", // check all project files
    "python.analysis.exclude": [
        "**/assert/**", // ignore assets from checks
        "**/test_files/**"
    ],
    // 🗂 File explorer
    "files.exclude": {
        "**/__pycache__": true,
        "**/.pytest_cache": true,
        "**/.mypy_cache": false,
        "**/dist": false,
        "**/build": false,
        "**/assets": false
    },
    // 🔎 Search bar
    "search.exclude": {
        "**/__pycache__": true,
        "**/.mypy_cache": true,
        "**/.pytest_cache": true,
        "**/assets/test_files": true,
        "**/dist": false,
        "**/build": false
    },
}